{
  // ==========================================================================
  // 工具箱子默认配置（模板）
  // --------------------------------------------------------------------------
  // 复制为同目录的 toolkit.config.jsonc（推荐）或 toolkit.config.json 后使用。
  // 真实配置不入库；机器相关值直接写在复制后的文件里。
  // ==========================================================================

  // ==========================================================================
  // 网络与代理
  // --------------------------------------------------------------------------
  // Clash Verge 本地 HTTP 代理端口；代理探测与联网脚本共用
  "ClashProxyPort": 7897,

  // Clash Verge 可执行文件路径；机器相关，按实际安装位置修改
  "ClashExePath": "C:\\Program Files\\Clash Verge\\clash-verge.exe",

  // ==========================================================================
  // 子进程与超时
  // --------------------------------------------------------------------------
  // 维护类命令的默认超时秒数（update-all 等使用）
  "DefaultTimeoutSeconds": 300,

  // ==========================================================================
  // 终端输出
  // --------------------------------------------------------------------------
  // 语义消息对应的终端颜色；键名供 Write-ToolkitMessage -Kind 使用
  "Colors": {
    "Success": "Green",
    "Info": "Cyan",
    "Warning": "Yellow",
    "Error": "Red",
    "Muted": "Gray"
  },

  // ==========================================================================
  // ef 检索目录
  // --------------------------------------------------------------------------
  // ef 工具遍历的目录列表；支持绝对路径与 %USERPROFILE% 等环境变量。
  "EfSearchRoots": [
    "%USERPROFILE%\\library",
    "%USERPROFILE%\\projects",
    "%USERPROFILE%\\Downloads"
  ],

  // ==========================================================================
  // 外部工具目录
  // --------------------------------------------------------------------------
  // sync-agents：Subagent 定义文件所在目录（也可在脚本配置 subagentsRoot 中覆盖）
  "SubagentsRoot": "%USERPROFILE%\\path\\to\\subagents",

  // ppt：ppt-master 仓库目录
  "PptMasterRoot": "%USERPROFILE%\\path\\to\\ppt-master",

  // ==========================================================================
  // 项目专属路径
  // --------------------------------------------------------------------------
  // 逻辑名 -> 绝对路径；机器相关，默认留空，按需直接填写
  "ProjectPaths": {}
}
