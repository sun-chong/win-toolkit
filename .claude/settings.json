{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \".claude/hooks/ps1-parse-check.ps1\"",
            "timeout": 30,
            "statusMessage": "校验 PowerShell 语法"
          }
        ]
      }
    ]
  }
}
