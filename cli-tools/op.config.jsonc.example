{
  // op 配置示例：复制为 op.config.jsonc（推荐）或 op.config.json 后修改。
  // 脚本优先读取 .jsonc；真实配置不入库。
  //
  // apps：追加到开始菜单应用之后的自定义应用
  //   Name    显示名
  //   Command 可执行文件路径、URL、shell: 协议或目录路径
  //
  // websites：网页条目
  //   Url   单个网址 → 显示为 WebAPP：
  //   Urls  多个网址 → 显示为 WebGroup：，启动时逐个打开
  //
  // 注意：旧格式中的 launchCount 会在首次运行时迁移到状态文件，迁移会重写本文件，
  //       届时注释与格式不会保留。
  "apps": [
    {
      "Name": "记事本",
      "Command": "%WINDIR%\\System32\\notepad.exe"
    }
  ],
  "websites": [
    {
      "Name": "示例网页",
      "Url": "https://example.com"
    },
    {
      "Name": "示例网页组",
      "Urls": [
        "https://example.com/a",
        "https://example.com/b"
      ]
    }
  ]
}
