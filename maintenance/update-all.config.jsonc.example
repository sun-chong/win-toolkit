{
  // ==========================================================================
  // update-all.ps1 配置模板
  // --------------------------------------------------------------------------
  // 用法：复制本文件为同目录的 update-all.config.jsonc，再按本机需求增删。
  //       update-all.config.jsonc 不入库，每台机器维护自己的清单。
  //
  // 格式为 JSONC：允许 // 注释和尾随逗号（PowerShell 7 原生支持）。
  //
  // 阶段按数组顺序执行；阶段内固定按 commands → winget → repos 执行。
  // 所有阶段跑完后，脚本会固定追加一个「清理 Temp 目录」阶段，无需在此配置。
  // ==========================================================================

  // 单个任务的默认超时（秒），阶段内可用 timeoutSeconds 单独覆盖。
  // 仅对 commands / repos 生效；winget 项保持交互式直接执行，不套超时。
  "timeoutSeconds": 300,

  "stages": [
    // ----------------------------------------------------------------------
    // 阶段一：系统级工具
    // ----------------------------------------------------------------------
    {
      // title 原样输出为终端里的分段标题。
      "title": "系统级工具 (WinGet)",

      // commands 先于 winget 执行，因此可在这里先刷新包源。
      // 每项是一条完整命令，由 cmd.exe 执行，可用 %USERPROFILE% 等环境变量。
      "commands": [
        "winget source update"
      ],

      // winget 项只写包 ID，脚本统一拼成：
      //   winget upgrade --id <id> -e --source winget -i
      "winget": [
        "OpenJS.NodeJS.LTS"
      ]
    },

    // ----------------------------------------------------------------------
    // 阶段二：第三方包管理器
    // ----------------------------------------------------------------------
    {
      "title": "第三方包管理器",
      "commands": [
        "bun upgrade",
        "uv self update"
      ]
    },

    // ----------------------------------------------------------------------
    // 阶段三：同步开源仓库
    // ----------------------------------------------------------------------
    {
      "title": "同步开源仓库",

      // repos 的每一项是「仓库根目录」，不是单个仓库路径。
      // 目录按 <owner>/<repo> 两层排列，脚本自动发现第二层下所有含 .git
      // 的目录并逐个 git pull。可写多个根目录。
      // 根目录不存在时只警告并跳过。
      "repos": [
        "%USERPROFILE%\\code"
      ]
    }
  ]
}
